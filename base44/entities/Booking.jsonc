{
  "name": "Booking",
  "type": "object",
  "properties": {
    "booking_ref": {
      "type": "string",
      "description": "Unique booking reference code"
    },
    "customer_name": {
      "type": "string",
      "description": "Full name of the customer"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email address"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "origin": {
      "type": "string",
      "description": "Pickup location"
    },
    "destination": {
      "type": "string",
      "description": "Drop-off location"
    },
    "origin_coords": {
      "type": "object",
      "description": "Latitude and longitude of origin",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "destination_coords": {
      "type": "object",
      "description": "Latitude and longitude of destination",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan",
        "minivan",
        "minibus"
      ],
      "description": "Type of vehicle"
    },
    "distance_km": {
      "type": "number",
      "description": "Distance in kilometers"
    },
    "price": {
      "type": "number",
      "description": "Total price in euros"
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected extra services (IDs)"
    },
    "extras_price": {
      "type": "number",
      "description": "Total price of extras in euros"
    },
    "transfer_date": {
      "type": "string",
      "format": "date",
      "description": "Date of transfer"
    },
    "transfer_time": {
      "type": "string",
      "description": "Time of transfer"
    },
    "flight_number": {
      "type": "string",
      "description": "Flight number (optional)"
    },
    "passengers": {
      "type": "number",
      "description": "Number of passengers"
    },
    "luggage": {
      "type": "number",
      "description": "Number of luggage pieces"
    },
    "notes": {
      "type": "string",
      "description": "Special requests or notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid",
      "description": "Payment status"
    },
    "driver_id": {
      "type": "string",
      "description": "ID do motorista respons\u00e1vel"
    },
    "driver_name": {
      "type": "string",
      "description": "Nome do motorista (cache)"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "ID do evento criado no Google Calendar"
    },
    "language": {
      "type": "string",
      "enum": [
        "pt",
        "en",
        "es",
        "fr",
        "de",
        "nl"
      ],
      "default": "pt",
      "description": "Idioma selecionado na reserva"
    }
  },
  "required": [
    "customer_name",
    "customer_email",
    "origin",
    "destination",
    "vehicle_type",
    "transfer_date",
    "transfer_time"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "driver"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "driver"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}