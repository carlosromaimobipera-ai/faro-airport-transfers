{
  "name": "Booking",
  "type": "object",
  "properties": {
    "booking_ref": {
      "type": "string",
      "description": "Unique booking reference code"
    },
    "linked_booking_ref": {
      "type": "string",
      "description": "Refer\u00eancia da reserva associada (ida e volta ligadas)"
    },
    "customer_name": {
      "type": "string",
      "description": "Full name of the customer"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email address"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "origin": {
      "type": "string",
      "description": "Pickup location"
    },
    "destination": {
      "type": "string",
      "description": "Drop-off location"
    },
    "origin_coords": {
      "type": "object",
      "description": "Latitude and longitude of origin",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "destination_coords": {
      "type": "object",
      "description": "Latitude and longitude of destination",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "trip_type": {
      "type": "string",
      "enum": [
        "one_way",
        "round_trip"
      ],
      "default": "one_way",
      "description": "One-way or round trip"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "description": "Return date (for round trips)"
    },
    "return_time": {
      "type": "string",
      "description": "Return time (for round trips)"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "sedan",
        "premium",
        "minivan",
        "minibus"
      ],
      "description": "Type of vehicle"
    },
    "distance_km": {
      "type": "number",
      "description": "Distance in kilometers"
    },
    "price": {
      "type": "number",
      "description": "Total price in euros"
    },
    "extras": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Selected extra services (IDs)"
    },
    "extras_price": {
      "type": "number",
      "description": "Total price of extras in euros"
    },
    "transfer_date": {
      "type": "string",
      "format": "date",
      "description": "Date of transfer"
    },
    "transfer_time": {
      "type": "string",
      "description": "Time of transfer"
    },
    "flight_number": {
      "type": "string",
      "description": "Flight number (optional)"
    },
    "return_flight_number": {
      "type": "string",
      "description": "Return flight number (optional)"
    },
    "passengers": {
      "type": "number",
      "description": "Number of passengers"
    },
    "luggage": {
      "type": "number",
      "description": "Number of luggage pieces"
    },
    "notes": {
      "type": "string",
      "description": "Special requests or notes"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes visible only to admin"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Booking status"
    },
    "driver_status": {
      "type": "string",
      "enum": [
        "assigned",
        "on_the_way",
        "on_site",
        "on_board",
        "done"
      ],
      "description": "Step-by-step driver execution status"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid",
      "description": "Payment status"
    },
    "driver_id": {
      "type": "string",
      "description": "ID do motorista respons\u00e1vel"
    },
    "driver_name": {
      "type": "string",
      "description": "Nome do motorista (cache)"
    },
    "driver_email": {
      "type": "string",
      "description": "Email do motorista (cache) - usado para RLS"
    },
    "google_calendar_event_id": {
      "type": "string",
      "description": "ID do evento criado no Google Calendar"
    },
    "language": {
      "type": "string",
      "enum": [
        "pt",
        "en",
        "es",
        "fr",
        "de",
        "nl"
      ],
      "default": "pt",
      "description": "Idioma selecionado na reserva"
    },
    "review_requested": {
      "type": "boolean",
      "default": false,
      "description": "Se o pedido de avalia\u00e7\u00e3o Google j\u00e1 foi enviado automaticamente"
    }
  },
  "required": [
    "customer_name",
    "customer_email",
    "origin",
    "destination",
    "vehicle_type",
    "transfer_date",
    "transfer_time"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.driver_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.driver_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}