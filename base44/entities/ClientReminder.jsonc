{
  "name": "ClientReminder",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID da reserva"
    },
    "booking_ref": {
      "type": "string",
      "description": "Refer\u00eancia da reserva"
    },
    "reminder_date": {
      "type": "string",
      "description": "Data do lembrete (YYYY-MM-DD)"
    },
    "sent_at": {
      "type": "string",
      "description": "Timestamp ISO do envio"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notas adicionais sobre este lembrete"
    }
  },
  "required": [
    "booking_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}