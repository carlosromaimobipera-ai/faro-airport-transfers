{
  "name": "EmailSent",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID da reserva"
    },
    "email_type": {
      "type": "string",
      "description": "Tipo de email enviado (ex: feedback_request)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notas adicionais sobre este email enviado"
    }
  },
  "required": [
    "booking_id",
    "email_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}