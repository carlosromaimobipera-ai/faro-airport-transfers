{
  "name": "Review",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID da reserva"
    },
    "booking_ref": {
      "type": "string",
      "description": "Refer\u00eancia da reserva"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "customer_email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "rating": {
      "type": "number",
      "description": "Classifica\u00e7\u00e3o de 1 a 5"
    },
    "comment": {
      "type": "string",
      "description": "Coment\u00e1rio do cliente"
    },
    "route": {
      "type": "string",
      "description": "Rota da viagem (cache)"
    },
    "transfer_date": {
      "type": "string",
      "format": "date",
      "description": "Data da viagem"
    },
    "google_redirect": {
      "type": "boolean",
      "default": false,
      "description": "Se o cliente clicou para Google"
    }
  },
  "required": [
    "booking_id",
    "rating"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}