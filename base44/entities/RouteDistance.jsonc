{
  "name": "RouteDistance",
  "type": "object",
  "properties": {
    "lookup_key": {
      "type": "string",
      "description": "Chave composta: 'oLat,oLng|dLat,dLng' (coordenadas arredondadas a 3 casas)"
    },
    "origin_lat": {
      "type": "number",
      "description": "Latitude da origem (arredondada a 3 casas)"
    },
    "origin_lng": {
      "type": "number",
      "description": "Longitude da origem (arredondada a 3 casas)"
    },
    "destination_lat": {
      "type": "number",
      "description": "Latitude do destino (arredondada a 3 casas)"
    },
    "destination_lng": {
      "type": "number",
      "description": "Longitude do destino (arredondada a 3 casas)"
    },
    "distance_km": {
      "type": "number",
      "description": "Dist\u00e2ncia real por estrada em km"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o estimada em minutos"
    },
    "source": {
      "type": "string",
      "enum": [
        "osrm",
        "google"
      ],
      "description": "Servi\u00e7o de roteamento que produziu este valor"
    }
  },
  "required": [
    "lookup_key",
    "origin_lat",
    "origin_lng",
    "destination_lat",
    "destination_lng",
    "distance_km",
    "source"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}