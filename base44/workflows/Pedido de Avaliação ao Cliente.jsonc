{
  "name": "Pedido de Avalia\u00e7\u00e3o ao Cliente",
  "description": "Envia email ao cliente pedindo avalia\u00e7\u00e3o quando a reserva \u00e9 marcada como conclu\u00edda.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Booking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pedido_de_avalia_o_ao_cliente",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendReviewRequest",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendReviewRequest"
  }
}